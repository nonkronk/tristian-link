/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-cache, no-transform

/admin/*
  ! Cache-Control
  Cache-Control: no-store

/styles.css
  ! Cache-Control
  Cache-Control: public, max-age=3600

/app.js
  ! Cache-Control
  Cache-Control: public, max-age=3600

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=3600

/favicon-16x16.png
  ! Cache-Control
  Cache-Control: public, max-age=3600

/favicon-32x32.png
  ! Cache-Control
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=3600

/card.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
