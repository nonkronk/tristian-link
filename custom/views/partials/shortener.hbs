<main class="tl-shortener">
  <section class="tl-hero" aria-labelledby="tl-shortener-title">
    <div class="tl-command"><span class="tl-prompt">❯</span> shorten</div>
    {{#if link}}
      <div class="tl-result-status">✓ done</div>
      <div id="shorturl" class="tl-result">
        <div class="clipboard">
          <button type="button" aria-label="Copy shortened link" hx-on:click="handleShortURLCopyLink(this);" data-url="{{url}}">
            {{> icons/copy}}
          </button>
          {{> icons/check}}
        </div>
        <h1 id="tl-shortener-title" class="link" hx-on:click="handleShortURLCopyLink(this);" data-url="{{url}}" title="Copy shortened link">{{link}}</h1>
      </div>
      <p class="tl-hint">click the link to copy it. tiny victory achieved.</p>
    {{else}}
      <div id="shorturl">
        <div>
          <h1 id="tl-shortener-title">Make long links <span>less annoying.</span></h1>
          <p class="tl-subtitle">Paste a URL. Get a short one. That's it.</p>
        </div>
      </div>
    {{/if}}
  </section>

  <form id="shortener-form" hx-post="/api/links" hx-trigger="submit queue:none" hx-target="closest main" hx-swap="outerHTML" autocomplete="off">
    <div class="target-wrapper {{#if errors.target}}error{{/if}}">
      <label class="tl-sr-only" for="target">Long URL</label>
      <input id="target" name="target" type="text" placeholder="https://example.com/a/needlessly/long/link" aria-label="Long URL" autofocus="true" data-lpignore="true" hx-preserve="true" />
      <button class="submit tl-submit" aria-label="Shorten link">
        <span class="tl-submit-label">Shorten <span aria-hidden="true">↵</span></span>
        {{> icons/spinner}}
      </button>
      {{#if errors.target}}<p class="error">{{errors.target}}</p>{{/if}}
      {{#unless errors}}{{#if error}}<p class="error">{{error}}</p>{{/if}}{{/unless}}
    </div>

    <label id="advanced" class="checkbox tl-options-toggle">
      <input name="show_advanced" type="checkbox" hx-on:change="htmx.toggleClass('#advanced-options', 'hidden')" {{#if show_advanced}}checked="true"{{/if}} />
      <span><span aria-hidden="true">+</span> options</span>
    </label>

    <section id="advanced-options" class="tl-options {{#unless show_advanced}}hidden{{/unless}}">
      <div class="advanced-input-wrapper">
        <label class="{{#if errors.domain}}error{{/if}}">
          Domain
          <select id="domain" name="domain" hx-preserve="true" hx-on:change="const elm = document.querySelector('#customurl-label span'); if (!elm) return; elm.textContent = event.target.value + '/';">
            <option value={{default_domain}}>{{default_domain}}</option>
            {{#each domains}}<option value={{address}}>{{address}}</option>{{/each}}
          </select>
          {{#if errors.domain}}<p class="error">{{errors.domain}}</p>{{/if}}
        </label>

        <label id="customurl-label" class="{{#if errors.customurl}}error{{/if}}">
          Alias
          <span id="customurl-label-value" class="tl-domain-prefix" hx-preserve="true">{{default_domain}}/</span>
          <input type="text" id="customurl" name="customurl" placeholder="my-link" hx-preserve="true" autocomplete="off" />
          {{#if errors.customurl}}<p class="error">{{errors.customurl}}</p>{{/if}}
        </label>

        <label class="{{#if errors.password}}error{{/if}}">
          Password
          <input type="password" id="password" name="password" placeholder="optional" hx-preserve="true" autocomplete="new-password" />
          {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
        </label>
      </div>

      <div class="advanced-input-wrapper">
        <label class="expire-in {{#if errors.expire_in}}error{{/if}}">
          Expire in
          <input type="text" id="expire_in" name="expire_in" placeholder="2 hours / 30 days / 1 year" hx-preserve="true" />
          {{#if errors.expire_in}}<p class="error">{{errors.expire_in}}</p>{{/if}}
        </label>

        <label class="description {{#if errors.description}}error{{/if}}">
          Description
          <input type="text" id="description" name="description" placeholder="what is this link for?" hx-preserve="true" />
          {{#if errors.description}}<p class="error">{{errors.description}}</p>{{/if}}
        </label>
      </div>
    </section>

    <p class="tl-shortcuts" aria-label="Keyboard shortcuts"><kbd>/</kbd> focus URL <span>·</span> <kbd>⌘/Ctrl K</kbd> commands</p>
  </form>
</main>
