{
  "name": "tristian-link-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tristian-link-preview",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIENT_CREATE_LIMIT",
      "namespace_id": "43001",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "GLOBAL_CREATE_LIMIT",
      "namespace_id": "43002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview"
  }
}
